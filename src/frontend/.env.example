# IBVAP-SIM / KAAL — Frontend Environment Configuration
# Copy to .env.local for local overrides, or configure in your deployment hosting dashboard.

# Backend REST API base URL (HTTP or HTTPS)
VITE_API_URL=http://127.0.0.1:8000

# Backend WebSocket telemetry base URL (WS or WSS)
VITE_WS_URL=ws://127.0.0.1:8000

# Supabase Cloud Architecture (Future Cloud Mode)
# VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_... or anon key
